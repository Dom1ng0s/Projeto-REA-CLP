# Copie para .env e preencha com os valores do seu projeto Supabase.
# Pegue as chaves em: Supabase Dashboard > Project Settings > API
# NÃO faça commit do .env real.

FLASK_APP=src.app
FLASK_ENV=development
SECRET_KEY=troque_por_uma_chave_aleatoria_longa

# Banco de dados — Supabase Transaction Pooler (porta 6543)
DATABASE_URL=postgresql+psycopg://postgres.SEU_PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres

# Supabase
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=SEU_JWT_SECRET  # Dashboard > Settings > API > JWT Secret

# CORS — domínios que podem chamar esta API
# Dev: Vite (5173) ou Wrangler local (8787)
# Produção: https://nexos-rea.nexosrea.workers.dev
CORS_ORIGINS=http://localhost:8787,http://localhost:5173,https://nexos-rea.nexosrea.workers.dev

# Banco local para testes (docker-compose up db)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nexos_rea_test
