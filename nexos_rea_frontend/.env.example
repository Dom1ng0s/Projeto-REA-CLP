# Copie para .env e preencha com os valores do seu projeto Supabase.
# Pegue em: Supabase Dashboard > Project Settings > API
# NÃO faça commit do .env real.

# --- Cliente (expostas no navegador via Vite; a anon/publishable é pública por design) ---
VITE_SUPABASE_PROJECT_ID="seu-project-ref"
VITE_SUPABASE_URL="https://seu-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-publishable-key"

# --- Servidor (SSR; NÃO expor no navegador) ---
SUPABASE_PROJECT_ID="seu-project-ref"
SUPABASE_URL="https://seu-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# --- Supabase CLI (db push/dump) ---
SUPABASE_DB_PASSWORD="senha-do-banco"
